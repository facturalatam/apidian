APP_NAME="APIDIAN"
APP_VERSION=" v2.1"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_PORT=80
APP_URL=http://127.0.0.1:${APP_PORT}
FORCE_HTTPS=false

LOG_CHANNEL=daily

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# si se inicia con docker usar el host del docker-compose.yml
# DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=db_api
DB_USERNAME=user_api
DB_PASSWORD=password_api
DB_PORT_EXTERNAL=3306

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME=

FILESYSTEM_DRIVER=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ALLOW_PUBLIC_DOWNLOAD=true
APPLY_SEND_CUSTOMER_CREDENTIALS=true
GRAPHIC_REPRESENTATION_TEMPLATE=2

APP_FOOTER="Facturalatam.com Community Edition"

ALLOW_PUBLIC_REGISTER=true
VALIDATE_BEFORE_SENDING=true
SAVE_RESPONSE_DIAN_TO_DB=false

ENABLE_API_REGISTER=true

URL_API_CERT_MODERNIZER="http://62.146.176.127:8091"
PDFTOTEXT_PATH="/usr/bin/pdftotext" # Para windows usar la ruta completa del ejecutable, por ejemplo: C:\Program Files\poppler\Library\bin\pdftotext.exe